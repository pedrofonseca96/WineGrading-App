// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       String  @id @default(uuid())
  username String  @unique
  password String
  grades   Grade[]
}

model Event {
  id     String   @id @default(uuid())
  name   String
  date   DateTime @default(now())
  status           String   @default("active") // active, finished
  currentWineOrder Int      @default(1)
  presentationMode Boolean  @default(false)
  presentationRevealCount Int @default(0)
  creatorId        String   @default("system") // Temporary default for migration
  wines            Wine[]
  grades Grade[]
}

model Wine {
  id          String  @id @default(uuid())
  name        String? // Nullable until revealed/added by admin
  description String?
  order       Int // The order in the blind tasting (1, 2, 3...)
  imageUrl    String?
  eventId     String
  event       Event   @relation(fields: [eventId], references: [id])
}

model Grade {
  id         String @id @default(uuid())
  userId     String
  user       User   @relation(fields: [userId], references: [id])
  eventId    String
  event      Event  @relation(fields: [eventId], references: [id])
  wineOrder  Int // Corresponds to Wine.order
  colorScore Int // 1-3
  smellScore Int // 1-7
  tasteScore Int // 1-10

  @@unique([userId, eventId, wineOrder])
}
